[
  {
    "rule": "application-no-tauri-sdk",
    "source": "src/features/alpha/application/service.ts",
    "target": "@tauri-apps/api/core"
  },
  {
    "rule": "application-no-vue-component",
    "source": "src/features/alpha/application/service.ts",
    "target": "../ui/Panel.vue"
  },
  {
    "rule": "cross-feature-public-api",
    "source": "src/features/alpha/ui/Panel.vue",
    "target": "../../beta/internal"
  },
  {
    "rule": "domain-framework-free",
    "source": "src/features/alpha/domain/model.ts",
    "target": "vue"
  },
  {
    "rule": "entry-bootstrap-only",
    "source": "src/bootstrap/main.ts",
    "target": "@/lib/helper"
  },
  {
    "rule": "lib-no-reverse-deps",
    "source": "src/lib/helper.ts",
    "target": "../components/Btn.vue"
  },
  {
    "rule": "ui-no-direct-tauri",
    "source": "src/features/alpha/ui/Panel.vue",
    "target": "@tauri-apps/api/core"
  }
]
