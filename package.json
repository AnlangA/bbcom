{
  "name": "bbcom",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src/",
    "format": "prettier --write src/ && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src/ && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:frontend": "node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bench:frontend": "node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/perf.bench.ts",
    "bench:frontend:write": "BENCH_WRITE=1 node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/perf.bench.ts",
    "bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm run test:frontend && pnpm run test:rust",
    "coverage:frontend": "c8 pnpm run test:frontend",
    "cycles": "madge --circular --extensions ts --ts-config tsconfig.json src/",
    "check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test",
    "coverage:lib": "c8 --per-file --include='src/lib/**' --exclude='src/lib/ipc.ts' --exclude='src/lib/version.ts' --exclude='src/lib/storage.ts' --exclude='src/lib/secure-settings.ts' --exclude='src/lib/buffer-config.ts' --exclude='src/lib/locales/**' --lines=90 --branches=0 --functions=0 --statements=0 pnpm run test:frontend"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "ansi_up": "^6.0.6",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.40.0",
    "pinia": "^2.2.0",
    "tauri-plugin-serialplugin-api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "c8": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vue-eslint-parser": "^9.0.0",
    "vue-tsc": "^2.2.0"
  }
}
