{
  "name": "bbcom",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.5.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src/",
    "format": "prettier --write src/ tests/frontend/ scripts/ docs/ package.json pnpm-workspace.yaml vite.config.ts eslint.config.mjs tsconfig.json tsconfig.node.json index.html .github/workflows/ && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src/ tests/frontend/ scripts/ docs/ package.json pnpm-workspace.yaml vite.config.ts eslint.config.mjs tsconfig.json tsconfig.node.json index.html .github/workflows/ && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:frontend": "node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "bench:frontend": "node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/perf.bench.ts",
    "bench:frontend:write": "BENCH_WRITE=1 node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/perf.bench.ts",
    "bench:rust": "cargo bench --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm run test:frontend && pnpm run test:rust",
    "coverage:frontend": "c8 pnpm run test:frontend",
    "cycles": "node scripts/check-architecture.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run architecture && pnpm run build && pnpm run test",
    "coverage:lib": "c8 --per-file --include='src/lib/**' --exclude='src/lib/ipc.ts' --exclude='src/lib/version.ts' --exclude='src/lib/storage.ts' --exclude='src/lib/secure-settings.ts' --exclude='src/lib/buffer-config.ts' --exclude='src/lib/locales/**' --lines=90 --branches=0 --functions=0 --statements=0 pnpm run test:frontend"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@tanstack/vue-virtual": "^3.13.31",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "ansi_up": "^6.0.6",
    "naive-ui": "^2.40.0",
    "pinia": "^3.0.4",
    "tauri-plugin-serialplugin-api": "^3.0.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  }
}
