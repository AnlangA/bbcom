{
  "name": "bbcom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test:frontend": "node --test --experimental-strip-types --import ./tests/frontend/register-loader.mjs tests/frontend/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "pnpm run test:frontend && pnpm run test:rust",
    "check": "pnpm run lint && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "ansi_up": "^6.0.6",
    "naive-ui": "^2.40.0",
    "pinia": "^2.2.0",
    "tauri-plugin-serialplugin-api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vue-eslint-parser": "^9.0.0",
    "vue-tsc": "^2.2.0"
  }
}
