{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-assistant",
  "description": "Least-privilege capabilities for the AI assistant window",
  "windows": ["ai-assistant"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "store:allow-load",
    "store:allow-get",
    "store:allow-delete",
    "store:allow-save"
  ]
}
