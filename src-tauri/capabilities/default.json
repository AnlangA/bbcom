{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window capabilities for bbcom",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "serialplugin:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-delete",
    "store:allow-save"
  ]
}
