#!/usr/bin/env bash
# Full local quality gate (coverage, browser E2E, benchmark comparison) before
# publishing commits. Install with `pnpm run hooks:install`; the pre-commit
# hook runs the fast gate only.
set -euo pipefail

repository_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf '%s\n' 'bbcom pre-push: unable to locate the Git worktree.' >&2
  exit 1
}

cd "$repository_root"

# Git sends one ref-update record per line on stdin. None of the quality gates
# consume those records, and forwarding them lets stdin-aware test runners
# mistake a ref record for a spec path. Drain the records before spawning pnpm.
cat >/dev/null
exec pnpm run precommit:full
